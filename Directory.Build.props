<Project>

  <!-- Shared version and NuGet package metadata for every project in the solution. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Guillermo Espert Carrasquer</Authors>
    <Company>Guillermo Espert Carrasquer</Company>
    <Product>AdfDotNet</Product>
    <Copyright>Copyright (c) 2026 Guillermo Espert Carrasquer</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/decimvs/AdfDotNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/decimvs/AdfDotNet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/decimvs/AdfDotNet/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Build settings: XML docs, SourceLink (built into the .NET 8+ SDK), symbol packages, deterministic builds. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
